# Backend — copy to backend/.env, never commit real secrets
MONGO_URI=mongodb://127.0.0.1:27017/open_novels
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=5000
FRONTEND_URL=http://localhost:5173
# Email verification (Gmail: create an App Password at myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=OpenNovels <you@gmail.com>
